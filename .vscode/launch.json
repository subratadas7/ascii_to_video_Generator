{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Convert Default (input.mp4)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Convert High Quality (160 cols, 15 FPS)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["input.mp4", "--width", "160", "--fps", "15.0", "--smoothing", "0.30"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
